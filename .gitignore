# =============================================================================
# .gitignore — telotrons Snakemake pipeline
#
# Tracked:  Snakefile, config.yaml, scripts/, envs/, profiles/, CLAUDE.md,
#           data/ placeholders (.gitkeep), .gitignore
# Ignored:  everything large, downloaded, generated, or machine-local (below).
# =============================================================================

# --- Downloaded raw data: NCBI RefSeq + Tara SMAGs + telomerase.us (~700 GB) ---
/raw/

# --- Generated manifests: downloaded summaries + derived TSVs (~23 GB) ---
/manifests/

# --- Pipeline outputs (~300 GB, incl. multi-GB all_introns_scanned.tsv) ---
/results/
# stale / ad-hoc output-dir variants
/results_*/
/results.test_*/
/manifests.test_*/

# --- Downstream analysis: AlphaFold3 bundles, TERT/TR search (~1 GB) ---
/analysis/

# --- Run logs ---
/logs/

# --- Prior-generation reference archive (do not commit; treat as cold storage) ---
/old/

# --- Snakemake working state (metadata, locks, conda envs, shadow, iocache) ---
.snakemake/

# --- Local tool binaries ---
/tools/

# --- AlphaFold3 / fold result bundles ---
*.zip

# --- Stray one-off data files at repo root ---
/o
/mitis_all.fa

# --- Temp / editor / tool leftovers ---
*.seed
hat?.seed
pre
~$*
*.tmp
*.swp
.~lock.*

# --- Python ---
__pycache__/
*.pyc
*.pyo

# --- Editor / OS ---
.DS_Store
.idea/
.vscode/

# --- Claude Code local config ---
.claude/

# =============================================================================
# data/ holds small input-sequence dirs (TERT-seqs/, TR-seqs/, Other-seqs/)
# kept via .gitkeep. If large FASTAs land there, ignore them specifically, e.g.:
#   data/**/*.fna
#   data/**/*.faa
# =============================================================================
