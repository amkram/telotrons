# =============================================================================
# .gitignore — telotrons Snakemake pipeline
#
# Tracked at root: Snakefile, config.yaml, scripts/, envs/*.yaml,
#                  CLAUDE.md, paper.md, .gitignore
#
# Four root subdirs (post-2026-06-05 deslop):
#   scripts/   tracked
#   envs/      *.yaml tracked, materialised envs gitignored
#   data/      raw inputs (downloads) gitignored
#   work/      pipeline outputs + logs + archive gitignored
# =============================================================================

# --- Downloaded raw data (RefSeq, Tara SMAGs, telomerase.us, long-read FASTQ) ---
/data/raw/

# --- Pipeline work tree (outputs, manifests, logs, archive) ---
/work/

# --- Snakemake metadata, locks, conda env materialisations ---
.snakemake/
/envs/*/
/.mmroot/

# --- Python ---
__pycache__/
*.pyc
*.pyo

# --- Temp / editor / tool leftovers ---
*.seed
hat?.seed
pre
~$*
*.tmp
*.swp
.~lock.*
*.zip
fasterq.tmp*

# --- Editor / OS ---
.DS_Store
.idea/
.vscode/

# --- Claude Code local config ---
.claude/
memory/
analysis/
logs
